{
  "name": "dndrom",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first 3D tabletop with an AI Dungeon Master",
  "license": "MIT",
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "dev": "pnpm --filter @dndrom/desktop dev",
    "build": "pnpm --filter @dndrom/desktop build",
    "preview": "pnpm --filter @dndrom/desktop preview",
    "test": "pnpm --filter @dndrom/desktop test && pnpm --filter @dndrom/signaling test && cargo test --workspace",
    "test:web": "pnpm --filter @dndrom/desktop test",
    "typecheck": "pnpm --filter @dndrom/desktop typecheck",
    "check": "pnpm typecheck && pnpm test && pnpm build && cargo check --workspace",
    "desktop:dev": "pnpm --filter @dndrom/desktop tauri dev",
    "desktop:package": "pnpm --filter @dndrom/desktop tauri build",
    "desktop:build": "pnpm desktop:package && pnpm smoke:packaged",
    "smoke:packaged": "node scripts/smoke-packaged.mjs",
    "signaling": "pnpm --filter @dndrom/signaling start"
  }
}
